{
  "name": "ai-social-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "playwright test --project live",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
